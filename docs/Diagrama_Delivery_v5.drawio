Point x="6351" y="3504"/><mxPoint x="6351" y="2327"/></Array></mxGeometry></mxCell><mxCell id="leg319" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Cores por camada&lt;/b&gt;&lt;br&gt;Azul: dominio&lt;br&gt;Cinza: objetos de transporte (DTO)&lt;br&gt;Laranja: aplicacao (controladores, servicos e fabricas)&lt;br&gt;Lilas: repositorios&lt;br&gt;Verde escuro: interfaces&lt;br&gt;Verde claro: implementacoes de infraestrutura&lt;br&gt;Amarelo: enumeracoes&lt;br&gt;&lt;br&gt;&lt;b&gt;Padroes GRASP&lt;/b&gt; nos estereotipos de cada classe.&lt;br&gt;Protected Variations nao consta nos slides da disciplina;&lt;br&gt;ali o equivalente e Polimorfismo + Indirecao.&lt;br&gt;&lt;br&gt;&lt;b&gt;Criterio das dependencias&lt;/b&gt;: desenhadas quando a classe usa&lt;br&gt;outra que nao possui. Tipos primitivos e enumeracoes&lt;br&gt;foram omitidos para nao poluir." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="2589" width="430" height="285" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>